# Tailored by Tee — environment variables
#
# Copy to .env.local for local development and fill in real values there.
# Never commit .env.local. On Vercel, set these in Project → Settings → Environment Variables
# (the Neon integration adds DATABASE_URL and DATABASE_URL_UNPOOLED for you).

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, structured data and payment callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection (hostname contains "-pooler"): used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler"): used by Prisma migrations and the seed script.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Where the catalogue is read from: "database" or "seed" (the typed demo catalogue).
# Defaults to "database" when DATABASE_URL is set, otherwise "seed".
# CATALOG_SOURCE="database"

# ── Payments (Paystack) ──────────────────────────────────────────────────────
# Paystack dashboard → Settings → API Keys & Webhooks. Test keys (sk_test_/pk_test_)
# run payments in Paystack's sandbox, and the site says so on every payment screen.
# Set the webhook URL there to: https://<your-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# ── Accounts (Auth.js) ───────────────────────────────────────────────────────
# Signs session cookies. Generate one: `npx auth secret`, or any 32+ random bytes, base64.
AUTH_SECRET=""
# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URIs: http://localhost:3000/api/auth/callback/google
#                           https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) — sign-in links and order emails ─────────────────────────
# resend.com → API Keys. Without a verified domain, Resend's test sender only
# delivers to your own Resend account address; verify a domain to email customers.
RESEND_API_KEY=""
# e.g. "Tailored by Tee <hello@yourdomain.com>" (defaults to Resend's test sender)
EMAIL_FROM=""

# ── Media (Cloudinary) — added with the media phase ─────────────────────────
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
